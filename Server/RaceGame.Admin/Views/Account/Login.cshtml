@model string
@{
    Layout = null;
}
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>系统管理员登录 - RaceGame 管理后台</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css">

    <style>
        body {
            background: linear-gradient(135deg, #EEF0F8 0%, #F6F7FD 50%, #E8EBFA 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            overflow: hidden;
        }

        .ambient-glow-1 {
            position: absolute;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(108, 93, 211, 0.15) 0%, rgba(108, 93, 211, 0) 70%);
            top: -100px;
            left: -100px;
            pointer-events: none;
        }

        .ambient-glow-2 {
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0, 210, 181, 0.12) 0%, rgba(0, 210, 181, 0) 70%);
            bottom: -150px;
            right: -150px;
            pointer-events: none;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: #FFFFFF;
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 16px 40px rgba(108, 93, 211, 0.08), 0 4px 12px rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(228, 232, 240, 0.8);
            position: relative;
            z-index: 1;
        }

        .login-logo {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            background: var(--color-primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 26px;
            margin: 0 auto 16px;
            box-shadow: var(--shadow-btn-primary);
        }
    </style>
</head>
<body>
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>

    <div class="login-card">
        <div class="text-center mb-4">
            <div class="login-logo">
                <i class="bi bi-heptagon-half"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">RaceGame 运营后台</h3>
            <p class="text-muted small">请输入系统管理权限凭据以进入控制台</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-4 rounded-3" style="font-size: 13px;">
                <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                <div>@ViewBag.Error</div>
            </div>
        }

        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model" />

            <div class="mb-3">
                <label class="form-label-modern">管理账号 (Username)</label>
                <div class="position-relative">
                    <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text"
                           class="form-control-modern ps-5"
                           name="username"
                           placeholder="输入管理员账号"
                           required
                           autofocus />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label-modern">访问密码 (Password)</label>
                <div class="position-relative">
                    <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="password"
                           class="form-control-modern ps-5"
                           name="password"
                           placeholder="输入密码"
                           required />
                </div>
            </div>

            <button type="submit" class="btn-modern-primary w-100 py-3 mb-3 justify-content-center" style="font-size: 15px;">
                <i class="bi bi-box-arrow-in-right"></i> 立即登入系统
            </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
            <small class="text-muted d-block">
                <i class="bi bi-shield-check text-success me-1"></i> Core V2.0 审计保护已就绪
            </small>
        </div>
    </div>
</body>
</html>

