<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - RaceGame 运营管理后台</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Admin Design System -->
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <!-- Left Sidebar Navigation -->
        <aside class="admin-sidebar">
            <!-- Brand Logo -->
            <a class="sidebar-brand" href="/">
                <div class="sidebar-logo">
                    <i class="bi bi-heptagon-half"></i>
                </div>
                <div class="sidebar-brand-text">
                    <span>RaceGame</span>
                    <span class="sidebar-brand-sub">Admin V2.0</span>
                </div>
            </a>

            <!-- Quick Action CTA Button (Matching "Register patient +" in reference) -->
            <button class="sidebar-cta-btn" type="button" data-bs-toggle="modal" data-bs-target="#quickActionModal">
                <i class="bi bi-plus-lg"></i>
                <span>快捷操作</span>
            </button>

            <!-- Navigation Links -->
            <nav class="sidebar-nav">
                <span class="nav-category">核心业务</span>

                @{
                    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
                    bool isOverview = currentPath == "/" || currentPath == "/home" || currentPath == "/home/index";
                    bool isPlayers = currentPath.StartsWith("/players");
                    bool isRounds = currentPath.StartsWith("/rounds");
                    bool isBets = currentPath.StartsWith("/bets");
                    bool isHorses = currentPath.StartsWith("/horses");
                    bool isRules = currentPath.StartsWith("/racerules");
                    bool isLogs = currentPath.StartsWith("/logs");
                }

                <a href="/" class="sidebar-link @(isOverview ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>仪表盘</span>
                </a>
                <a href="/Players" class="sidebar-link @(isPlayers ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>玩家管理</span>
                </a>
                <a href="/Rounds" class="sidebar-link @(isRounds ? "active" : "")">
                    <i class="bi bi-flag-fill"></i>
                    <span>比赛轮次</span>
                </a>
                <a href="/Bets" class="sidebar-link @(isBets ? "active" : "")">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>投注订单</span>
                </a>

                <span class="nav-category mt-3">配置与监控</span>
                <a href="/Horses" class="sidebar-link @(isHorses ? "active" : "")">
                    <i class="bi bi-trophy-fill"></i>
                    <span>马匹配置</span>
                </a>
                <a href="/RaceRules" class="sidebar-link @(isRules ? "active" : "")">
                    <i class="bi bi-sliders2-vertical"></i>
                    <span>比赛规则</span>
                </a>
                <a href="/Logs" class="sidebar-link @(isLogs ? "active" : "")">
                    <i class="bi bi-journal-code"></i>
                    <span>业务日志</span>
                </a>
            </nav>

            <!-- Bottom System Status Card (Matching "Get mobile app" in reference) -->
            <div class="sidebar-status-card">
                <div class="status-card-header">
                    <span class="status-card-title">系统核心引擎</span>
                    <span class="pulse-indicator">
                        <span class="pulse-dot"></span> 正常
                    </span>
                </div>
                <span class="status-card-desc">State Worker 调度及 Postgres 审计运行中</span>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="admin-main-container">
            <!-- Topbar Header -->
            <header class="admin-topbar">
                <!-- Mobile Toggle & Global Search -->
                <div class="d-flex align-items-center gap-3">
                    <button class="topbar-icon-btn d-lg-none" id="sidebarToggleBtn" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="search-container">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="search-input" id="globalSearchInput" placeholder="全局快速检索 (按任意内容)...">
                    </div>
                </div>

                <!-- Topbar Right Actions & Admin Profile -->
                <div class="topbar-actions">
                    <a href="javascript:location.reload()" class="topbar-icon-btn" title="刷新页面">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>

                    <div class="position-relative">
                        <button class="topbar-icon-btn" type="button" title="通知提醒">
                            <i class="bi bi-bell"></i>
                            <span class="badge-notice-dot"></span>
                        </button>
                    </div>

                    <!-- Admin Profile Section -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="profile-pill">
                            <div class="avatar-circle">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "A")
                            </div>
                            <div class="profile-info d-none d-sm-flex">
                                <span class="profile-name">@User.Identity.Name</span>
                                <span class="profile-role">系统超级管理员</span>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 d-inline">
                                <button type="submit" class="btn-logout" title="安全退出">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </header>

            <!-- Main Page Content -->
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Quick Action Modal -->
    <div class="modal fade" id="quickActionModal" tabindex="-1" aria-labelledby="quickActionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold" id="quickActionModalLabel">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>快捷操作通道
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <a href="/Horses/Edit" class="card card-modern p-3 text-decoration-none text-dark h-100">
                                <div class="stat-icon-squircle stat-icon-purple mb-2">
                                    <i class="bi bi-plus-circle"></i>
                                </div>
                                <div class="fw-bold">新增马匹</div>
                                <small class="text-muted">上架新马号及基础胜率</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="/RaceRules" class="card card-modern p-3 text-decoration-none text-dark h-100">
                                <div class="stat-icon-squircle stat-icon-orange mb-2">
                                    <i class="bi bi-sliders"></i>
                                </div>
                                <div class="fw-bold">调整规则</div>
                                <small class="text-muted">下注与赛跑时长配置</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="/Players" class="card card-modern p-3 text-decoration-none text-dark h-100">
                                <div class="stat-icon-squircle stat-icon-teal mb-2">
                                    <i class="bi bi-person-check"></i>
                                </div>
                                <div class="fw-bold">玩家查冻</div>
                                <small class="text-muted">查询账号与快捷封禁</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="/Logs?type=race" class="card card-modern p-3 text-decoration-none text-dark h-100">
                                <div class="stat-icon-squircle stat-icon-blue mb-2">
                                    <i class="bi bi-file-earmark-code"></i>
                                </div>
                                <div class="fw-bold">实时日志</div>
                                <small class="text-muted">监控比赛与马匹推进</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

