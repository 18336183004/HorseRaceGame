{
  // ⚠️ 开发基线配置 —— 切勿将真实密码或密钥提交至版本控制。
  // 本地开发请使用 dotnet user-secrets 或 appsettings.Local.json（已 gitignore）覆盖以下字段：
  //   ConnectionStrings:Default  — PostgreSQL 连接串（含密码）
  //   Jwt:Key                    — 至少 32 字符的随机密钥
  //   Redis:Password             — Redis 鉴权密码（若启用）
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=root"
  },
  "Redis": {
    "Connection": "localhost:6379",
    "Password": "",
    "AutoStart": true,
    "ServiceNames": [
      "Redis",
      "RedisStack",
      "Memurai"
    ],
    "ExecutablePath": "",
    "ConfigPath": ""
  },
  "Jwt": {
    "Issuer": "RaceGame",
    "Audience": "RaceGame",
    "Key": "dev-only-CHANGE_ME-must-be-at-least-32-chars!!"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:7456",
      "http://127.0.0.1:7456"
    ]
  }
}
